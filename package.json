{
  "name": "harbor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "mcp": "tsx --env-file-if-exists=.env app/mcp/server.ts",
    "mcp:stdio": "tsx --env-file-if-exists=.env core/mcp/stdio.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "tsx --env-file-if-exists=.env scripts/demo.ts",
    "demo:agents": "tsx --env-file-if-exists=.env scripts/agents.ts",
    "demo:chat": "tsx --env-file-if-exists=.env scripts/chat-demo.ts",
    "lint:config": "node scripts/lint-config.mjs",
    "check:spdx": "node scripts/check-spdx.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:license-leak": "node scripts/check-license-leak.mjs",
    "check:write-path": "node scripts/check-write-path.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:structure": "npm run check:spdx && npm run check:boundaries && npm run check:license-leak && npm run check:write-path && npm run check:migrations",
    "sandbox:build": "docker build -f sandbox/Dockerfile -t ${HARBOR_SANDBOX_IMAGE:-harbor-sandbox:latest} .",
    "sandbox:push": "node scripts/sandbox-push.mjs",
    "docker:build": "docker build -t ${HARBOR_IMAGE:-harbor:latest} .",
    "check": "npm run lint:config && npm run check:structure && npm run typecheck && npm run test",
    "docs:connectors": "tsx --env-file-if-exists=.env scripts/gen-connectors-doc.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@codesandbox/sdk": "^2.4.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vercel/sandbox": "^3.0.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "modal": "^0.9.0",
    "next": "^15.5.0",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.12",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
